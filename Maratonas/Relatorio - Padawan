
#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    int i, aux = 0;
    char cu;

    for (i = 0; i < n; i++) {
        scanf(" %c", &cu);
       
        if(cu != '0' || aux == 1){
           
            printf("%c", cu);
            aux = 1;
           
        }
    }
       
        if(aux == 0){
           
            printf("0", cu);
           
           
           
        }

     
     printf("\n");
     
     
     return 0;
     
    }
